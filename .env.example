# Copy to .env and fill in real values. Never commit .env.

# Required — the backend refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — Claude models and effort (defaults shown). A cheap model for the
# chat and the import fallback, a stronger one for the content that gets
# stored (exercises, meanings).
# CLAUDE_CHAT_MODEL=claude-haiku-5-5
# CLAUDE_GENERATION_MODEL=claude-sonnet-5-5
# CLAUDE_CHAT_EFFORT=low
# CLAUDE_GENERATION_EFFORT=medium
# CLAUDE_PARSE_MODEL=claude-haiku-5-5
# CLAUDE_PARSE_EFFORT=low

# PostgreSQL (used by docker-compose for both the database and the backend)
POSTGRES_USER=langlearn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=langlearn

# Only used when running the backend outside docker-compose
# (docker-compose builds its own URL from the POSTGRES_* values above).
DATABASE_URL=postgresql+asyncpg://langlearn:change-me@localhost:5432/langlearn
